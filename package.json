{
  "name": "shub",
  "version": "2026.10.0",
  "description": "shub - your session hub. All your Claude Code sessions in one window, grouped by project.",
  "scripts": {
    "test": "env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_COMMON_DIR node --test \"server/**/*.test.ts\" \"cli/**/*.test.ts\" \"test/**/*.test.ts\"",
    "dev": "node --watch server/main.ts",
    "start": "node server/main.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && svelte-check --tsconfig web/tsconfig.json",
    "lint": "prettier --check . && stylelint \"web/src/**/*.{css,svelte}\"",
    "format": "prettier --write .",
    "test:smoke": "playwright test"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "shub": "cli/shub.ts"
  }
}
